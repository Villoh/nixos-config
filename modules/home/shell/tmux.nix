{ inputs, pkgs, ... }:

let
  whichKey = pkgs.tmuxPlugins.tmux-which-key;

  # The plugin copies its example config out of the read-only store and then fails to write
  # init.tmux next to it, so build both here. Two example entries do not apply: the reload
  # macro sources ~/.tmux.conf, and the Plugins submenu drives TPM.
  whichKeyConfig =
    pkgs.runCommand "which-key-config.yaml"
      {
        nativeBuildInputs = [ pkgs.yq-go ];
      }
      ''
        yq 'del(.items[] | select(.name == "+Client") | .menu[] | select(.name == "+Plugins"))' \
          ${whichKey}/share/tmux-plugins/tmux-which-key/config.example.yaml \
          | sed 's|\$HOME/.tmux.conf|~/.config/tmux/tmux.conf|' > $out
      '';
  whichKeyInit = pkgs.runCommand "which-key-init.tmux" { } ''
    ${whichKey}/share/tmux-plugins/tmux-which-key/plugin/build.py ${whichKeyConfig} $out
  '';

  # continuum goes last: it appends its save hook to status-right.
  plugins = with pkgs.tmuxPlugins; [
    whichKey
    tmux-fzf
    fingers
    extrakto
    fzf-tmux-url
    tmux-floax
    resurrect
    continuum
  ];
in
{
  home.packages = [
    pkgs.tmux
    pkgs.sesh
    # PENDING: cache. Source build, swapped for the prebuilt release meanwhile.
    # inputs.workmux.packages.${pkgs.stdenv.hostPlatform.system}.default
    pkgs.workmux-bin
  ];

  xdg.configFile."tmux/plugins/tmux-which-key/config.yaml".source = whichKeyConfig;
  xdg.dataFile."tmux/plugins/tmux-which-key/init.tmux".source = whichKeyInit;

  # Nix owns this file, not chezmoi: the binds point at wrapped store binaries (fingers,
  # extrakto's python/fzf/clipboard tools, which-key's python), which a static dotfile cannot
  # reference. chezmoi owns tmux.conf (Omarchy's plus a last line that sources this one);
  # other OSes provide their own plugins.conf or none. Plugins come from nixpkgs, so no TPM.
  xdg.configFile."tmux/plugins.conf".text = ''
    # Generated by modules/home/shell/tmux.nix. Edit it there.

    # Prefix keys Omarchy and tmux already use: c C d D f h i k K l L m n N o p P q r R s t v w x z ? Space.
    # fingers defaults to F, which tmux-fzf takes.
    set -g @fingers-key y
    # floax defaults to p (previous-window) and P (Omarchy: previous session).
    set -g @floax-bind g
    set -g @floax-bind-menu G
    # which-key reads its menu from XDG paths, prebuilt above.
    set -g @tmux-which-key-xdg-enable 1
    set -g @tmux-which-key-disable-autobuild 1
    set -g @resurrect-dir "$HOME/.local/state/tmux/resurrect"
    set -g @resurrect-capture-pane-contents on
    set -g @continuum-restore on

    bind -N "Pick a session (sesh)" T display-popup -E -w 80% -h 70% -d "#{pane_current_path}" -T "Sessions" "sesh picker -i"
    # Omarchy's window tabs plus workmux's status icon (status_format: false in its config).
    set -g window-status-format "#[fg=brightblack] #I:#W#{?@workmux_status, #{@workmux_status},} "
    set -g window-status-current-format "#[fg=blue,bold] #I:#W#{?@workmux_status, #{@workmux_status},} "
    bind -N "Toggle workmux sidebar" B run-shell "workmux sidebar"
    bind -N "workmux dashboard" W display-popup -E -w 90% -h 90% -d "#{pane_current_path}" -T "workmux" "workmux dashboard"
    bind -N "workmux: last done or waiting agent" a run-shell "workmux last-done"
    bind -N "workmux: toggle last agent" A run-shell "workmux last-agent"

    ${builtins.concatStringsSep "\n" (map (p: "run-shell ${p.rtp}") plugins)}
  '';
}
