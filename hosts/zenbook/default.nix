{ config, inputs, pkgs, ... }:

{
  # Generate this host's hardware-configuration.nix on the Zenbook before
  # adding this host to flake.nix. Do not reuse desktop hardware settings.
  imports = [
    ./hardware-configuration.nix
    ../../modules/nixos/core
    # The RTX 3080 moves to a Thunderbolt eGPU; the Arc iGPU drives the desktop.
    ../../modules/nixos/hardware/egpu-nvidia.nix
    ../../modules/nixos/hardware/monitor-input.nix
    ../../modules/nixos/hardware/logitech-receiver.nix
    ../../modules/nixos/hardware/usb-oc.nix
    ../../modules/nixos/hardware/astro-mixamp.nix
    ../../modules/nixos/hardware/storage-tools.nix
    # Optional desktop services, selected by this host rather than the profile.
    ../../modules/nixos/services/docker.nix
    ../../modules/nixos/services/flatpak.nix
    ../../modules/nixos/services/printing.nix
    ../../modules/nixos/services/tailscale.nix
    ../../modules/nixos/services/kdeconnect.nix
    ../../profiles/laptop.nix
    ../../profiles/gaming.nix
    ../../users/mikel
    ../../users/mikel/al68.nix
    ../../modules/nixos/home-manager.nix
    ./display.nix
    ./keyboard.nix
    ./touchscreen.nix
    inputs.acid-boot.nixosModules.default
  ];

  home-manager.users.mikel.imports = [ ../../modules/home/gaming ];

  # Avalonia (Tunnel Agent) is X11-only; with force_zero_scaling it needs per-output scale.
  # shortcut: connector names depend on the port; if a monitor changes port its entry stops
  # matching, so update the names (`hyprctl monitors`).
  home-manager.users.mikel.home.sessionVariables.AVALONIA_SCREEN_SCALE_FACTORS = "eDP-1=2;HDMI-A-2=1.5;DP-3=1.5";

  networking.hostName = "nixos-zenbook";
  system.stateVersion = "26.05";

  # TEMPORARY: find who asks for the unexplained suspend with the lid closed on the desk
  # (2026-11-24). Remove once the cause is found; it makes logind noisy.
  systemd.services.systemd-logind.environment.SYSTEMD_LOG_LEVEL = "debug";

  boot.loader = {
    systemd-boot.enable = true;
    systemd-boot.configurationLimit = 5;
    efi.canTouchEfiVariables = true;
  };

  # Unlocks the swap partition declared in hardware-configuration.nix; the installer
  # kept this entry in /etc/nixos/configuration.nix, which the flake does not import.
  boot.initrd.luks.devices."luks-ad6ce096-c480-4d2f-84e7-551d22c89eae".device =
    "/dev/disk/by-uuid/ad6ce096-c480-4d2f-84e7-551d22c89eae";

  # Hibernate (S4) so the dock NIC can wake the laptop from a full power-off; swap is the
  # LUKS partition above, unlocked in the initrd before resume runs.
  boot.resumeDevice = "/dev/mapper/luks-ad6ce096-c480-4d2f-84e7-551d22c89eae";

  acidBoot = {
    enable = true;
    palette = "nix-blue";
  };

  # Early KMS for the Arc iGPU: without it Plymouth draws on simpledrm (the UEFI
  # framebuffer) and the LUKS prompt can come out stretched. mei_gsc_proxy must load
  # with it, or i915 waits 20 s for the GSC proxy and logs "GSC proxy component didn't
  # bind within the expected timeout".
  boot.initrd.kernelModules = [
    "i915"
    "mei_me"
    "mei_gsc_proxy"
  ];

  users.users.mikel.extraGroups = [ "docker" ];

  # Intel thermal daemon (Core Ultra); works alongside power-profiles-daemon.
  services.thermald.enable = true;

  # Firmware updates from LVFS (BIOS, NVMe, Thunderbolt...): `fwupdmgr get-updates`.
  services.fwupd.enable = true;

  # Always on AC (eGPU + hub): cap charge at 80% to cut high-voltage wear. The BIOS
  # has no such setting; asus-wmi exposes it through sysfs.
  systemd.services.battery-charge-limit = {
    wantedBy = [ "multi-user.target" ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStart = "/bin/sh -c 'echo 80 > /sys/class/power_supply/BAT0/charge_control_end_threshold'";
    };
  };

  # Wake-on-LAN (magic packet) on the dock's USB NIC. Matched by driver, not name: the
  # enp0s13f0u1u4u2 name follows the USB port path and changes if the dock moves port.
  services.udev.extraRules = ''
    ACTION=="add", SUBSYSTEM=="net", DRIVERS=="r8152", RUN+="${pkgs.ethtool}/bin/ethtool -s $name wol g"
  '';

  # Fixed address for the Android WoL status check, which needs an IP. DHCP stays on
  # (other networks keep working); the /32 adds no route. Matched by MAC, not name.
  # shortcut: .250 is only likely outside the router's DHCP pool, reserve it there to be sure.
  # TODO: .250 only works on the home LAN. A Tailscale IP (`tailscale up`, currently logged
  # out) would be the same everywhere, so this profile could go.
  networking.networkmanager.ensureProfiles.profiles.dock-ethernet = {
    connection = {
      id = "dock-ethernet";
      type = "ethernet";
      autoconnect-priority = 10; # wins over the autogenerated "Wired connection 1"
    };
    ethernet.mac-address = "6C:1F:F7:CB:E8:56";
    ipv4 = {
      method = "auto";
      address1 = "192.168.1.250/32";
    };
    ipv6.method = "auto";
  };

  # One shared login appearance, imported by nixpkgs before greetd starts. Missing
  # source files (fresh home) are skipped, so the greeter keeps its defaults.
  services.displayManager.dux-greeter.configHome = config.users.users.mikel.home;
}
